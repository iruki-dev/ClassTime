# Copy to `keystore.properties` and fill in. The real file is gitignored.
#
#   cp keystore.properties.example keystore.properties
#
# Equivalent environment variables (these win over this file):
#   CLASSTIME_KEYSTORE_FILE, CLASSTIME_KEYSTORE_PASSWORD,
#   CLASSTIME_KEY_ALIAS, CLASSTIME_KEY_PASSWORD
#
# Create the keystore itself with: ./scripts/create-keystore.sh

# Path to the keystore. Relative paths resolve against the repo root; `~/` works.
storeFile=secrets/classtime-release.jks
storePassword=CHANGE_ME
keyAlias=classtime
# Omit to reuse storePassword.
keyPassword=CHANGE_ME
