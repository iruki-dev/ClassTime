# --- Build output (any module, any depth) ---
build/
!gradle/wrapper/gradle-wrapper.jar
*.class
*.dex
*.apk
*.aab
captures/
.externalNativeBuild/
.cxx/

# --- Gradle ---
.gradle/
gradle-app.setting
!gradle/wrapper/gradle-wrapper.properties

# --- Local machine config (never shared) ---
local.properties
*.env

# --- Android Studio / IntelliJ ---
.idea/
*.iml
*.ipr
*.iws
.navigation/
captures/

# --- Signing keys & deployment secrets (never commit these) ---
*.jks
*.keystore
*.p12
key.properties
keystore.properties
!keystore.properties.example

